@@ -1237,7 +1238,9 @@ class MmuEnvironmentManager:
             prev_gate_selected = self.mmu.gate_selected
             for gate in gates:
                 self.mmu.select_gate(gate)
-                _,_,_,_ = self.mmu.move_filament("Rotating spool for drying", -100, motor="gear", wait=True)
