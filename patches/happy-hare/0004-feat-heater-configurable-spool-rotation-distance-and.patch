From dfeb95ae29df040a9d8bc87cd0175e7dd4670592 Mon Sep 17 00:00:00 2001
From: Cedric Hauber <hauber.c@gmail.com>
Date: Thu, 5 Nov 2026 14:25:43 +0100
Subject: [PATCH] feat(heater): configurable spool rotation distance and speed

Units whose gear turns the spool (gear_rotates_spool) always retracted 100 mm at the
default gear speed. heater_rotate_distance and heater_rotate_speed set that move; the
QIDI Box stock firmware retracts 50 mm at 80 mm/s every 5 minutes. The drying status
also tells whether the cycle rotates the spools.
---
 config/base/mmu_parameters.cfg             |  4 +++
 extras/mmu/unit/mmu_environment_manager.py |  5 ++-
 extras/mmu/unit/mmu_unit_parameters.py     |  2 ++
 test/test_mmu_drying.py                    | 40 ++++++++++++++++++++++
 4 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/config/base/mmu_parameters.cfg b/config/base/mmu_parameters.cfg
index 6cbcc486..07cf9308 100644
--- a/config/base/mmu_parameters.cfg
+++ b/config/base/mmu_parameters.cfg
@@ -532,6 +532,10 @@ heater_vent_interval        : [[PARAM_HEATER_VENT_INTERVAL]]			# Interval in min
 heater_pause_temp           : [[PARAM_HEATER_PAUSE_TEMP]]			# Drying heater while the print is paused: -1=keep drying, 0=turn off, other=lower to this temperature
 [% if MMU_HAS_ESPOOLER or MMU_GEAR_ROTATES_SPOOL %]
 heater_rotate_interval      : [[PARAM_HEATER_ROTATE_INTERVAL]]			# Interval in minutes to rotate filament (requires the filament end attached to spool)
+[% if MMU_GEAR_ROTATES_SPOOL %]
+heater_rotate_distance      : 100			# Gear retract (mm) that turns each spool at every rotation
+heater_rotate_speed         : 0			# Speed (mm/s) of that retract, 0 = default gear speed
+[% endif %]
 [% endif %]
 [% if MMU_GEAR_ROTATES_SPOOL and MULTIGEAR %]
 heater_rotate_in_print      : [[PARAM_HEATER_ROTATE_IN_PRINT]]			# EXPERIMENTAL: 1=keep rotating with idle gears while printing (needs DRY=1 ROTATE=1, may cause short print pauses)
