From c222a3813d775e4447316a28c2dc943a01a2407e Mon Sep 17 00:00:00 2001
From: Cedric Hauber <hauber.c@gmail.com>
Date: Thu, 5 Nov 2026 14:27:14 +0100
Subject: [PATCH] feat(dialog): extra buttons on the pause dialog

The pause dialog is built in Python since #1421, so a client can no longer add actions with its own macro. MMU_ERROR_DIALOG BUTTONS= adds them, for example a one-tap retry of a failed load.
---
 extras/mmu/commands/mmu_error_dialog.py | 11 +++++++++--
 extras/mmu/mmu_dialog.py                |  8 ++++++--
 test/test_mmu_error_dialog.py           |  8 ++++++++
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/extras/mmu/commands/mmu_error_dialog.py b/extras/mmu/commands/mmu_error_dialog.py
index ac7b54d4..a120b6d7 100644
--- a/extras/mmu/commands/mmu_error_dialog.py
+++ b/extras/mmu/commands/mmu_error_dialog.py
@@ -28,7 +28,8 @@ class MmuErrorDialogCommand(BaseCommand):
         f"{CMD}: {HELP_BRIEF}\n"
         + "MSG   = _text_ Lines (separated by \\n) shown after the reason, replacing the default resume hint\n"
         + "ABORT = [0|1] Add an ABORT (CANCEL_PRINT) button\n"
-        + "RESET = [0|1] Clear MSG and ABORT (applied before them)\n"
+        + "BUTTONS = _text_ Extra buttons, comma separated: Label|GCODE|style (primary, warning, error...)\n"
+        + "RESET = [0|1] Clear MSG, ABORT and BUTTONS (applied before them)\n"
         + "(no parameters to report current settings)\n"
     )
     HELP_SUPPLEMENT = (
@@ -56,6 +57,7 @@ class MmuErrorDialogCommand(BaseCommand):
         reset = gcmd.get_int('RESET', 0, minval=0, maxval=1)
         msg = gcmd.get('MSG', None)
         abort = gcmd.get_int('ABORT', None, minval=0, maxval=1)
+        buttons = gcmd.get('BUTTONS', None)
 
         if reset:
             dialog.reset()
@@ -63,8 +65,13 @@ class MmuErrorDialogCommand(BaseCommand):
             dialog.set(lines=msg.replace("\\n", "\n").split("\n"))
         if abort is not None:
             dialog.set(show_abort=bool(abort))
+        if buttons is not None:
+            parsed = [tuple(part.strip() for part in button.split("|")) for button in buttons.split(",") if button.strip()]
+            if any(len(button) != 3 for button in parsed):
+                raise gcmd.error("BUTTONS needs Label|GCODE|style, comma separated")
+            dialog.set(buttons=parsed)
 
-        if not (reset or msg is not None or abort is not None):
+        if not (reset or msg is not None or abort is not None or buttons is not None):
             self.mmu.log_always(
                 "Error dialog %s\nText: %s\nButtons: %s" % (
                     "enabled" if self.mmu.p.show_error_dialog else "disabled (show_error_dialog=0)",
diff --git a/extras/mmu/mmu_dialog.py b/extras/mmu/mmu_dialog.py
index d00275bd..05458778 100644
--- a/extras/mmu/mmu_dialog.py
+++ b/extras/mmu/mmu_dialog.py
@@ -97,19 +97,23 @@ class MmuErrorDialog(MmuDialog):
         self.mmu = mmu
         self.extra_lines = [] # Shown after the reason, replacing DIALOG_RESUME_HINT when there is no action
         self.show_abort = False
+        self.extra_buttons = [] # "Label|GCODE|style" shown before the standard buttons
 
-    def set(self, lines=None, show_abort=None):
+    def set(self, lines=None, show_abort=None, buttons=None):
         if lines is not None:
             self.extra_lines = [flatten(l) for l in lines if flatten(l)]
         if show_abort is not None:
             self.show_abort = show_abort
+        if buttons is not None:
+            self.extra_buttons = list(buttons)
 
     def reset(self):
         self.extra_lines = []
         self.show_abort = False
+        self.extra_buttons = []
 
     def buttons(self):
-        return ([ABORT_BUTTON] if self.show_abort else []) + [RESUME_BUTTON, UNLOCK_BUTTON]
+        return self.extra_buttons + ([ABORT_BUTTON] if self.show_abort else []) + [RESUME_BUTTON, UNLOCK_BUTTON]
 
     def show_error(self, headline, reason, hint=None, context=None, still_paused=False, unlock_first=False):
         """
diff --git a/test/test_mmu_error_dialog.py b/test/test_mmu_error_dialog.py
index dc13fa05..acbe23c7 100644
--- a/test/test_mmu_error_dialog.py
+++ b/test/test_mmu_error_dialog.py
@@ -360,6 +360,14 @@ class TestDialogConfiguration(ErrorDialogTestCase):
         self.assertEqual(self.footer_buttons(dialog)[0], ['ABORT', 'CANCEL_PRINT', 'error'])
         self.assertIn('Start-up help', self.texts(dialog))
 
+    def test_extra_buttons_come_first_and_reset_clears_them(self):
+        self.gcode('MMU_ERROR_DIALOG BUTTONS="Retry load|RETRY_MACRO|primary,Other|OTHER_MACRO|warning"')
+        labels = [button[0] for button in self.mmu.error_dialog.buttons()]
+        self.assertEqual(labels[:2], ['Retry load', 'Other'])
+        self.assertEqual(self.mmu.error_dialog.buttons()[0], ('Retry load', 'RETRY_MACRO', 'primary'))
+        self.gcode('MMU_ERROR_DIALOG RESET=1')
+        self.assertEqual(self.mmu.error_dialog.extra_buttons, [])
+
     def test_reset_command_restores_the_defaults(self):
         self.start_print()
         self.gcode('MMU_ERROR_DIALOG ABORT=1 MSG="Custom"')
-- 
