 extras/mmu/commands/mmu_gate_map.py  |  2 +
 extras/mmu/mmu_constants.py          |  1 +
 test/test_mmu_spool_created_event.py | 55 ++++++++++++++++++++++++++++
 4 files changed, 63 insertions(+)
 create mode 100644 test/test_mmu_spool_created_event.py

diff --git a/config/macros/mmu_state.cfg b/config/macros/mmu_state.cfg
