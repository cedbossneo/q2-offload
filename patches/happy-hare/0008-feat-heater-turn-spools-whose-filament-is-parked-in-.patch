diff --git a/test/test_mmu_drying.py b/test/test_mmu_drying.py
index d9635f51..cae4f6cc 100644
--- a/test/test_mmu_drying.py
+++ b/test/test_mmu_drying.py
@@ -12,6 +12,8 @@ from test.hh import profiles, session
 from test.hh.bootstrap import PRINTER_STUB
 
 ENV_CHECK_INTERVAL = 30
+FILAMENT_POS_UNLOADED = 0
+FILAMENT_POS_LOADED = 10
 
 
 class _FakeHumidityChip:
@@ -718,5 +720,121 @@ class TestDryingRotation(unittest.TestCase):
         self.assertEqual(self.moves, [(0, -50.0, 80.0), (1, -50.0, 80.0)])
 
 
+class TestDryingRotationLoaded(unittest.TestCase):
+    """heater_rotate_loaded_travel: spools whose filament is parked in the gate turn too, by moving
+    the filament back and forth behind the parking position (never forward, toward the hub)."""
+
+    def setUp(self):
+        self.hh = session('qidi')
+        self.addCleanup(self.hh.close)
+        self.hh.boot()
+        self.mmu = self.hh.mmu
+        self.unit = self.mmu.mmu_unit(0)
+        self.unit.p.heater_rotate_distance = 100.0
+        self.unit.p.heater_rotate_speed = 80.0
+        self.unit.p.heater_rotate_loaded_travel = 250.0
+        self.moves = []
+        real_move = self.mmu.move_filament
+
+        def record(trace_str, dist, speed=None, **kwargs):
+            if "spool" in trace_str and "drying" in trace_str:
+                self.moves.append((self.mmu.gate_selected, dist))
+            return real_move(trace_str, dist, speed=speed, **kwargs)
+        self.mmu.move_filament = record
+        # Gate 0 ejected (spool end secured), gates 1-3 hold filament parked in the gate
+        self.hh.run_gcode('MMU_GATE_MAP GATES=0 AVAILABLE=0 QUIET=1')
+        self.hh.run_gcode('MMU_GATE_MAP GATES=1,2,3 AVAILABLE=1 QUIET=1')
+        self.mmu.set_filament_pos_state(FILAMENT_POS_UNLOADED, silent=True)
+
+    def _start(self):
+        self.hh.run_gcode('MMU_HEATER DRY=1 TEMP=45 TIMER=600 ROTATE=1')
+        self.hh.settle()
+
+    def _intervals(self, n):
+        for _ in range(n):
+            self.hh.reactor.advance(self.unit.p.heater_rotate_interval * 60 + ENV_CHECK_INTERVAL)
+
+    def _gate_moves(self, gate):
+        return [d for g, d in self.moves if g == gate]
+
+    def test_off_by_default(self):
+        self.unit.p.heater_rotate_loaded_travel = 0.0
+        self._start()
+        self._intervals(1)
+        self.assertEqual(self.moves, [(0, -100.0)])
+
+    def test_parked_spools_sweep_back_and_forth_behind_the_park_position(self):
+        self._start()
+        self._intervals(5)
+        self.assertEqual(self._gate_moves(0), [-100.0] * 5)       # empty gate: plain retract
+        self.assertEqual(self._gate_moves(1), [-100.0, -100.0, -50.0, 100.0, 100.0])
+        positions, pos = [], 0.0
+        for d in self._gate_moves(2):
+            pos += d
+            positions.append(pos)
+        self.assertEqual(positions, [-100.0, -200.0, -250.0, -150.0, -50.0])
+        self.assertTrue(all(-250.0 <= p <= 0.0 for p in positions))
+
+    def test_stopping_returns_each_filament_to_its_park_position(self):
+        self._start()
+        self._intervals(2)
+        self.hh.run_gcode('MMU_HEATER STOP=1')
+        self.hh.settle()
+        for gate in (1, 2, 3):
+            self.assertEqual(sum(self._gate_moves(gate)), 0.0)
+        self.assertEqual(self._gate_moves(1)[-1], 200.0)
+
+    def test_the_gate_loaded_in_the_toolhead_is_not_moved(self):
+        self.mmu.select_gate(2)
+        self.mmu.set_filament_pos_state(FILAMENT_POS_LOADED, silent=True)
+        self._start()
+        self._intervals(2)
+        self.assertEqual(self._gate_moves(2), [])
+        self.assertEqual(self._gate_moves(1), [-100.0, -100.0])
+
+    def test_no_sweep_while_printing_and_the_position_is_kept_for_later(self):
+        self._start()
+        self._intervals(1)
+        with mock.patch.object(self.mmu, 'is_in_print', return_value=True):
+            self._intervals(1)
+            self.hh.run_gcode('MMU_HEATER STOP=1')
+            self.hh.settle()
+        self.assertEqual(self._gate_moves(1), [-100.0])
+        # The next cycle carries on from where the filament really is
+        self._start()
+        self._intervals(3)
+        self.assertEqual(self._gate_moves(1), [-100.0, -100.0, -50.0, 100.0])
+
+    def test_a_gate_homed_by_happy_hare_is_not_moved_back_at_the_end(self):
+        self._start()
+        self._intervals(1)
+        self.mmu.printer.send_event("mmu:gate_homed", 3)    # a load or preload: parked afresh
+        self.hh.run_gcode('MMU_HEATER STOP=1')
+        self.hh.settle()
+        self.assertEqual(self._gate_moves(3), [-100.0])
+        self.assertEqual(self._gate_moves(1), [-100.0, 100.0])
+
+    def test_positions_are_saved_for_a_restart(self):
+        self._start()
+        self._intervals(2)
+        saved = self.mmu.var_manager.get('mmu_state_drying_sweep', None, namespace=self.unit.name)
+        self.assertEqual(saved, [0.0, -200.0, -200.0, -200.0])
+        em = self.unit.environment_manager
+        em._sweep_offset = {}
+        em._handle_ready()
+        self.assertEqual(em._sweep_offset, {1: -200.0, 2: -200.0, 3: -200.0})
+        self.hh.run_gcode('MMU_HEATER STOP=1')
+        self.hh.settle()
+        self.assertEqual(self.mmu.var_manager.get('mmu_state_drying_sweep', None, namespace=self.unit.name),
+                         [0.0, 0.0, 0.0, 0.0])
+
+    def test_real_homing_publishes_the_gate(self):
+        events = []
+        self.mmu.printer.register_event_handler("mmu:gate_homed", events.append)
+        self.mmu.select_gate(1)
+        self.mmu._set_gate_homed_state(self.mmu._gate_profile())
+        self.assertEqual(events, [1])
+
+
 if __name__ == '__main__':
     unittest.main()
