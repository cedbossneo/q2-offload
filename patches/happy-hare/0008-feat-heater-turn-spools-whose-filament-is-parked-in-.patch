+    #
+    # Parked spool sweep (heater_rotate_loaded_travel)
+    #
+    # A gear that turns the spool can only turn it by moving the filament. With the filament
+    # parked in the gate it is moved back and forth between the parking position and
+    # heater_rotate_loaded_travel behind it, never forward: on units whose gates merge into a
+    # shared path the parked tip is just short of the merge. The travel must stay within the
+    # length the gear keeps hold of the filament behind the park.
+    #
+    # Each position is saved and only forgotten when Happy Hare homes that gate again (a load,
+    # unload or preload), so offsets never add up. A filament left behind its park (a print
+    # started, a restart) is harmless: the next load homes to the gate sensor anyway.
+    #
+
+    def _gate_parked(self, gate):
+        """The filament of 'gate' is parked in its gate (not loaded toward the toolhead)"""
+        try:
+            if self.mmu.gate_status[gate] != GATE_AVAILABLE:
+                return False
+        except (IndexError, TypeError):
+            return False
+        return not (gate == self.mmu.gate_selected and self.mmu.filament_pos != FILAMENT_POS_UNLOADED)
+
+
+    def _can_move_gears(self):
+        return not self.mmu.is_in_print() and self.mmu.action == ACTION_IDLE
+
+
+    def _can_sweep(self, gate):
+        return (self.mmu_unit.gear_rotates_spool
+                and self.mmu_unit.p.heater_rotate_loaded_travel > 0.
+                and self._can_move_gears()
+                and self._gate_parked(gate))
+
+
+    def _sweep_target(self, gate):
+        """Next position of 'gate' and the direction after it, bouncing between -travel and 0"""
+        travel = self.mmu_unit.p.heater_rotate_loaded_travel
+        offset = self._sweep_offset.get(gate, 0.)
+        direction = self._sweep_dir.get(gate, -1)
+        target = offset + direction * self.mmu_unit.p.heater_rotate_distance
+        if target <= -travel:
+            return -travel, 1
+        if target >= 0.:
+            return 0., -1
+        return target, direction
+
+
+    def _move_parked_spool(self, gate, target, trace_str):
+        delta = target - self._sweep_offset.get(gate, 0.)
+        if abs(delta) < 0.01:
+            return
+        self.mmu.select_gate(gate)
+        try:
+            self.mmu.move_filament(trace_str, delta, speed=self.mmu_unit.p.heater_rotate_speed or None,
+                                   motor="gear", wait=True)
+        except MmuError as e:
+            # Position unknown, but behind the parking position: leave it for the next homing
+            self.mmu.log_warning("Gate %d: spool turning stopped (%s)" % (gate, str(e)))
+            self._sweep_dir.pop(gate, None)
+            return
+        if target < 0.:
+            self._sweep_offset[gate] = target
+        else:
+            self._sweep_offset.pop(gate, None)
+
+
+    def _sweep_parked_spools(self, gates):
+        self.mmu.log_info("Turning spools parked in gates: %s..." % ",".join(map(str, gates)))
+        prev_gate_selected = self.mmu.gate_selected
+        for gate in gates:
+            target, direction = self._sweep_target(gate)
+            self._sweep_dir[gate] = direction
+            self._move_parked_spool(gate, target, "Turning parked spool for drying")
+        self.mmu.select_gate(prev_gate_selected)
+        self._save_sweep()
+
+
+    def _repark_swept_spools(self):
+        """Back to the parking position after drying. Not possible now: stays saved for later"""
+        self._sweep_dir = {}
+        gates = [gate for gate in sorted(self._sweep_offset) if self._gate_parked(gate)]
+        if not gates or not self._can_move_gears():
+            return
+        prev_gate_selected = self.mmu.gate_selected
+        for gate in gates:
+            self._move_parked_spool(gate, 0., "Returning parked spool after drying")
+        self.mmu.select_gate(prev_gate_selected)
+        self._save_sweep()
+
+
+    def _handle_gate_homed(self, gate):
+        """Happy Hare homed 'gate' to its sensor: its position is known again"""
+        if self._sweep_offset.pop(gate, None) is not None:
+            self._sweep_dir.pop(gate, None)
+            self._save_sweep()
+
+
+    def _save_sweep(self):
+        u = self.mmu_unit
+        offsets = [round(self._sweep_offset.get(u.first_gate + lgate, 0.), 1) for lgate in range(u.num_gates)]
+        if any(offsets) or self.mmu_machine.var_manager.get(VARS_MMU_DRYING_SWEEP, None, namespace=u.name):
+            self.mmu_machine.var_manager.set(VARS_MMU_DRYING_SWEEP, offsets, namespace=u.name, write=True)
+
+
     def _rotate_spool(self, gate):
         """
         Send event to  cause a small rewind action to rotate the spool in gate
