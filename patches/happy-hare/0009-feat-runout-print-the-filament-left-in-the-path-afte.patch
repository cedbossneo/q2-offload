             park_pos = 0.
@@ -3108,6 +3116,60 @@ class MmuFilamentMovement:
 # TIP FORMING AND PURGING
 # -----------------------------------------------------------------------------------------------------------
 
+    def purge_runout_remains(self):
+        """
+        Push the end of a run-out filament out through the nozzle (runout_use_remaining). It is past
+        the gear, so nothing upstream can pull it back: the extruder feeds it until it clears the
+        extruder entry sensor, then past the extruder gears. What stays between the gears and the
+        nozzle is left for the next load to push out, like a cut fragment. The caller parks the
+        toolhead where it may purge.
+        """
+        u = self.mmu_unit()
+        toolhead = u.toolhead_wrapper.p
+        self.log_trace_entry("purge_runout_remains()")
+
+        bowden_length = u.calibrator.get_bowden_length()
+        if bowden_length < 0:
+            bowden_length = u.p.bowden_homing_max
+        max_length = bowden_length + u.p.gate_homing_max # Anywhere from the gate's entry to the extruder
+
+        with self.wrap_action(ACTION_PURGING):
+            self._ensure_safe_extruder_temperature(wait=True)
+            self.reset_sync_gear_to_extruder(False, force_grip=True)
+            self.log_info("Pushing the rest of the run-out filament out through the nozzle...")
+            # The extruder entry endstop lives on the gear rail. The gear helps while it still grips the end
+            actual, homed, _, _ = self.move_filament(
+                "Push run-out filament end to the extruder entry",
+                max_length,
+                speed=self.p.extruder_load_speed,
+                motor="gear+extruder",
+                homing_move=-1,
+                endstop_name=SENSOR_EXTRUDER_ENTRY,
+            )
+            if not homed:
+                self.set_filament_pos_state(FILAMENT_POS_UNKNOWN)
+                raise MmuError(
+                    "End of the run-out filament from %s did not clear the extruder entry sensor after pushing %.1fmm through the nozzle"
+                    % (self.gate_name(), actual),
+                    hint="Pull the rest of the filament out of the bowden and the extruder, " + HINT_RELOAD
+                )
+            self.move_filament(
+                "Push run-out filament end past the extruder gears",
+                toolhead.toolhead_entry_to_extruder + RUNOUT_REMAINS_GEAR_CLEARANCE,
+                speed=self.p.extruder_load_speed,
+                motor="extruder",
+                wait=True,
+            )
+
+        fragment = max(0., toolhead.toolhead_extruder_to_nozzle - RUNOUT_REMAINS_GEAR_CLEARANCE)
+        color = self.gate_color[self.gate_selected] if self.gate_selected >= 0 else UNKNOWN_FILAMENT_COLOR
+        u.extruder_wrapper.set_filament_remaining(fragment, color)
+        self.set_filament_pos_state(FILAMENT_POS_UNLOADED)
+        self.log_info("Run-out filament pushed out after %.1fmm, %.1fmm left in the toolhead (purged on next load)"
+                      % (actual, fragment))
+        self.log_trace_exit("purge_runout_remains() => None")
+
+
     def form_tip_standalone(self, extruder_only=False):
         """
         Form tip prior to extraction from the extruder. This can take the form of shaping the filament or could simply
@@ -3951,6 +4013,11 @@ class MmuFilamentMovement:
                     self.log_info("Proportional sensor indicates no extruder grip - filament may not be fully loaded")
                     self.set_filament_pos_state(FILAMENT_POS_IN_BOWDEN, silent=silent)
 
+        # Remains of a run-out spool being printed (runout_use_remaining): the gate and hub sensors no
+        # longer see them, the extruder entry sensor still does
+        elif not strict and self.filament_pos == FILAMENT_POS_LOADED and es and self.is_printing_runout_remains():
+            pass
+
         # On a no-Bowden unit the extruder-entry sensor is also the gate datum. A
         # triggered level proves filament reached the entrance but cannot distinguish
         # that point from filament extending through the extruder to the nozzle. Recover
