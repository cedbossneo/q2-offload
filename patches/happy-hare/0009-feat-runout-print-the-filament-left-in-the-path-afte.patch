diff --git a/test/test_mmu_runout_remaining.py b/test/test_mmu_runout_remaining.py
new file mode 100644
index 00000000..4fbad6e6
--- /dev/null
+++ b/test/test_mmu_runout_remaining.py
@@ -0,0 +1,228 @@
+# Happy Hare test harness - runout_use_remaining: print the filament left in the path after a
+# spool runs out, like the QIDI Box stock firmware.
+#
+# On a type-B MMU whose entry sensor sits before the gear (QIDI Box), the default runout pauses
+# as soon as the end of the filament clears the entry sensor, then unloads it with the gear.
+# By then the end may already be past the gear, and nothing can pull it back: the cut piece
+# stays in the bowden. With runout_use_remaining the print goes on with what is left in the
+# path, the real runout is the end clearing the extruder entry sensor, and the remains leave
+# through the nozzle. A toolchange in the meantime pushes the remains out the same way.
+#
+#   ./venv/bin/python -m unittest test.test_mmu_runout_remaining
+#
+# This file may be distributed under the terms of the GNU GPLv3 license.
+
+import logging
+import unittest
+
+from test.hh import session
+
+logging.getLogger().setLevel(logging.CRITICAL)
+
+FILAMENT_POS_UNLOADED = 0
+FILAMENT_POS_LOADED = 10
+GATE_EMPTY = 0
+TIP_AT_GATE = -40.0
+EXTRUDER_ENTRY = 900.0          # qidi profile layout
+SHARED_EXIT = 150.0
+ENTRY = -150.0                  # entry switch, before the gear
+
+
+class RunoutRemainingTestCase(unittest.TestCase):
+    PRELOAD_GATES = (0, 1, 2, 3)
+    GROUPS = '1,2,3,4'          # no EndlessSpool partner unless a test says so
+    USE_REMAINING = 1
+
+    def setUp(self):
+        self.hh = session('qidi')
+        self.hh.boot(calibrate=True)
+        self.assertEqual(self.hh.errors, [], 'bootup was not clean')
+        self.mmu = self.hh.mmu
+        self.fil = self.hh.filament()
+        for gate in self.PRELOAD_GATES:
+            self.hh.place_filament(gate, position=TIP_AT_GATE)
+            self.gcode('MMU_PRELOAD GATE=%d' % gate)
+        self.hh.heat_extruder(220)
+        self.gcode('MMU_ENDLESS_SPOOL GROUPS=%s ENABLE=1' % self.GROUPS)
+        self.mmu.p.runout_use_remaining = self.USE_REMAINING
+        self.assertEqual(self.hh.errors, [], 'setup was not clean')
+
+    def tearDown(self):
+        self.hh.close()
+
+    def gcode(self, script, settle=0.5):
+        self.hh.run_gcode(script)
+        self.hh.settle(settle)
+
+    def start_print(self, tool=0):
+        self.gcode('MMU_CHANGE_TOOL TOOL=%d' % tool)
+        self.hh.printer.lookup_object('print_stats').set_state('printing')
+        self.gcode('MMU_PRINT_START', settle=1.0)
+        self.assertEqual(self.hh.errors, [], 'print start failed')
+        self.assertTrue(self.mmu.is_printing())
+        return self.mmu.gate_selected
+
+    def run_out(self, gate):
+        """The spool ends: its tail clears the entry switch, as the print pulls filament."""
+        self.fil.exhaust(gate, at=ENTRY - 1.)
+        self.print_filament(gate, 2.)
+
+    def print_filament(self, gate, length):
+        """The print consumes filament: the whole piece moves toward the nozzle."""
+        self.fil.advance(gate, length, 'printing')
+        self.hh.settle(1.0)
+
+    def print_past(self, gate, position):
+        """Print until the tail has passed a path position."""
+        self.print_filament(gate, position - self.fil.tail[gate] + 1.)
+
+    def clear_errors(self):
+        del self.hh.gcode.errors[:]
+
+
+class TestDefaultStillPauses(RunoutRemainingTestCase):
+    USE_REMAINING = 0
+
+    def test_entry_runout_pauses_without_the_option(self):
+        gate = self.start_print()
+        self.run_out(gate)
+        self.assertTrue(self.mmu.is_mmu_paused(), 'the default behaviour must not change')
+
+
+class TestPrintingTheRemains(RunoutRemainingTestCase):
+
+    def test_entry_runout_keeps_printing(self):
+        gate = self.start_print()
+        self.run_out(gate)
+        self.assertEqual(self.hh.errors, [])
+        self.assertTrue(self.mmu.is_printing())
+        self.assertEqual(self.mmu.filament_pos, FILAMENT_POS_LOADED)
+
+    def test_the_exhausted_gate_is_marked_empty(self):
+        gate = self.start_print()
+        self.run_out(gate)
