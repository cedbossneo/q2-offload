             raise MmuError(reason, hint=hint)
 
 
+    def _endless_spool_load(self, next_gate):
+        self.select_gate(next_gate) # Necessary if unloaded to waste gate
+        self.gate_maps.remap_tool(self.tool_selected, next_gate)
+        self._select_and_load_tool(self.tool_selected, purge=PURGE_STANDALONE) # if user has set up standalone purging, respect option and purge.
+
+
+    def can_use_runout_remaining(self):
+        """
+        Whether runout_use_remaining applies: the end of the filament can be followed from its
+        gate's entry sensor to the extruder entry sensor, and no encoder would read it as a clog.
+        """
+        return (
+            bool(self.p.runout_use_remaining)
+            and self.gate_selected >= 0
+            and not self.has_encoder()
+            and self.sensor_manager.has_sensor(SENSOR_EXTRUDER_ENTRY)
+        )
+
+
+    def is_printing_runout_remains(self):
+        """
+        True while the loaded filament's spool has run out (runout_use_remaining): its gate's
+        entry sensor no longer sees it but it is still in the extruder. Read from the sensors, not
+        remembered, so it still holds after a restart or once the print has ended.
+        """
+        return (
+            self.can_use_runout_remaining()
+            and self.filament_pos >= FILAMENT_POS_EXTRUDER_ENTRY
+            and self.sensor_manager.check_gate_sensor(SENSOR_ENTRY_PREFIX, self.gate_selected) is False
+        )
+
+
+    def _runout_remains_printed(self, sensor):
+        """
+        The end of a run-out filament has cleared the extruder entry sensor (runout_use_remaining).
+        Push what is left out through the nozzle, then load the EndlessSpool replacement or pause.
+        """
+        self.runout_last_handled_time = self.reactor.monotonic()
+
+        with self.wrap_suspend_filament_monitoring():
+            self.is_handling_runout = True # Until complete and continue or resume after error
+            self._save_toolhead_position_and_park('runout')
+            where = "%s (%s)" % (self.selected_tool_string(), self.gate_name())
+            gate = self.gate_selected
+            self.log_info("Filament from %s used up (end seen by %s)" % (where, sensor))
+            self.purge_runout_remains()
+
+            self._next_tool = self.tool_selected # Valid only during the reload - cleared in _continue_after()
+            next_gate, msg = -1, ""
+            if self.endless_spool_enabled:
+                next_gate, msg = self.gate_maps.get_next_endless_spool_gate(self.tool_selected, gate)
+            if next_gate == -1:
+                raise MmuError(
+                    "Spool on %s ran out and the filament left in the path has been printed%s"
+                    % (where, "\nNo alternative gates available after checking %s" % msg if msg else ""),
+                    hint="Load a new spool into gate %d, load %s (MMU_CHANGE_TOOL TOOL=%d), then RESUME"
+                         % (gate, self.selected_tool_string(), self.tool_selected)
+                )
+
+            self.log_info("Remapping T%d to gate %d" % (self.tool_selected, next_gate))
+            try:
+                self._endless_spool_load(next_gate)
+            except (MmuError, self.printer.command_error) as e:
+                ee = self.mmu_error_from(e)
+                raise ee.with_context("Occurred during EndlessSpool swap of %s to gate %d" % (where, next_gate)) from e
+
+            self._continue_after("endless_spool")
+            self.pause_resume.send_resume_command() # Undo what runout sensor handling did
+
+
     # Wait for all movement to stop
     def movequeue_wait(self):
         self.toolhead.wait_moves()
